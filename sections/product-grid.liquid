<script type="application/json" class="products-json" data-role="shop">
{% render 'product-json', collection: section.settings.collection %}
</script>

<section id="shop" class="alt">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <a href="#bestsellers">Best Sellers ↑</a>
    </div>
    <div class="toolbar" id="filterBar" role="group" aria-label="Filter cookies">
      <button class="chip active" data-filter="all">All Cookies</button>
      <button class="chip" data-filter="stuffed">Stuffed</button>
      <button class="chip" data-filter="classics">Classics</button>
      <button class="chip" data-filter="boxes">Boxes &amp; Gifts</button>
      <select id="sortSelect" aria-label="Sort products">
        <option value="featured">Sort: Featured</option>
        <option value="price-low">Price: Low to High</option>
        <option value="price-high">Price: High to Low</option>
        <option value="rating">Top Rated</option>
        <option value="name">Name A–Z</option>
      </select>
    </div>
    <div class="grid" id="shopGrid"></div>
    <p id="noResults" hidden style="text-align:center;color:var(--muted);font-weight:700">No cookies match that filter — try another one.</p>
  </div>
</section>

{% schema %}
{
  "name": "Shop all cookies",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (leave empty to use all products)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop All Cookies" }
  ],
  "presets": [
    { "name": "Shop all cookies", "category": "Shurmble" }
  ]
}
{% endschema %}
