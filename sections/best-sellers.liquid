<script type="application/json" class="products-json" data-role="best">
{% render 'product-json', collection: section.settings.collection %}
</script>

<section id="bestsellers">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <a href="#shop">Shop All →</a>
    </div>
    <div class="grid" id="bestGrid"></div>
  </div>
</section>

{% schema %}
{
  "name": "Best sellers",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (leave empty to use all products)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nationwide Best Sellers" }
  ],
  "presets": [
    { "name": "Best sellers", "category": "Shurmble" }
  ]
}
{% endschema %}
