<header class="site">
  <div class="wrap">
    <div class="header-in">
      <button class="icon-btn menu-btn" id="menuBtn" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
      <a class="logo" href="{{ routes.root_url }}" aria-label="Shurmble home">sh<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 3a21 21 0 1 0 21 21c-5 0-8-3-8-8 0-1 .2-2 .6-2.9C36.4 14.3 33 15 30.5 13.7 28 12.4 26.5 10 26.5 7c0-1.5.5-2.9 1.4-4C26.6 3 25.3 3 24 3Z" fill="#c98a3d" /><circle cx="17" cy="19" r="3" fill="#4a2a10" /><circle cx="27" cy="27" r="3.2" fill="#4a2a10" /><circle cx="15" cy="32" r="2.6" fill="#4a2a10" /><circle cx="33" cy="36" r="2.4" fill="#4a2a10" /><circle cx="22" cy="12" r="2.2" fill="#4a2a10" /></svg>rmble</a>
      <nav class="main" aria-label="Main navigation">
        <a href="{{ routes.root_url }}#switcher">Flavours</a>
        <a href="{{ routes.root_url }}#boxbuilder">Build a Box</a>
        <a href="{{ routes.root_url }}#bestsellers">Best Sellers</a>
        <a href="{{ routes.root_url }}#shop">Shop All</a>
        <a href="{{ routes.root_url }}#gifting">Corporate Gifting</a>
        <a href="{{ routes.root_url }}#story">Our Story</a>
      </nav>
      <div class="header-actions">
        <button class="icon-btn" id="searchBtn" aria-label="Search cookies">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.8-3.8" /></svg>
        </button>
        <button class="icon-btn" id="wishBtn" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M12 20.7C6.4 17 3 13.6 3 9.9 3 7.2 5 5 7.6 5c1.7 0 3.4.9 4.4 2.4C13 5.9 14.7 5 16.4 5 19 5 21 7.2 21 9.9c0 3.7-3.4 7.1-9 10.8Z" /></svg>
          <span class="count-badge" id="wishCount" hidden>0</span>
        </button>
        <button class="icon-btn" id="cartBtn" aria-label="Open cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M5 8h14l-1.2 11a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" /><path d="M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10" /></svg>
          <span class="count-badge" id="cartCount" hidden>0</span>
        </button>
      </div>
    </div>
    <nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
      <a href="{{ routes.root_url }}#switcher">Flavours</a>
      <a href="{{ routes.root_url }}#boxbuilder">Build a Box</a>
      <a href="{{ routes.root_url }}#bestsellers">Best Sellers</a>
      <a href="{{ routes.root_url }}#shop">Shop All</a>
      <a href="{{ routes.root_url }}#gifting">Corporate Gifting</a>
      <a href="{{ routes.root_url }}#story">Our Story</a>
    </nav>
    <div class="search-bar" id="searchBar">
      <form id="searchForm" role="search">
        <input type="search" id="searchInput" placeholder="Search cookies… try “nutella” or “gift”" aria-label="Search cookies" />
        <button class="btn-navy" type="submit">Search</button>
      </form>
      <div class="search-results" id="searchResults"></div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
