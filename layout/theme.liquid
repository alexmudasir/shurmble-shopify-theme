<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light only" />
  <title>{{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}" />
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet" />
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --cloud: {{ settings.bg_color | default: '#f0eee9' }};
      --ink: {{ settings.ink_color | default: '#3a2317' }};
      --accent: {{ settings.accent_color | default: '#0057d9' }};
      --accent-deep: {{ settings.accent_deep_color | default: '#003fa3' }};
    }
  </style>
  <script>
    window.SHURMBLE = {
      freeShipThreshold: {{ settings.free_ship_threshold | default: 3000 }},
      currencySymbol: {{ settings.currency_symbol | default: "Rs. " | json }},
      currencyCode: {{ settings.currency_code | default: "PKR" | json }}
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }}">
  {% section 'announcement-bar' %}
  {% section 'header' %}

  {% comment %} Global product data so header search, quick view and wishlist work on every page {% endcomment %}
  <script type="application/json" class="products-json" data-role="shop">
{% render 'product-json' %}
  </script>

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <!-- Cart drawer -->
  <div class="scrim" id="scrim"></div>
  <aside class="drawer" id="cartDrawer" aria-label="Shopping cart">
    <div class="drawer-head">
      <h3>Your Box<span id="drawerCount"></span></h3>
      <button class="icon-btn" id="closeCart" aria-label="Close cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="drawer-body" id="cartBody"></div>
    <div class="drawer-foot" id="cartFoot"></div>
  </aside>

  <!-- Quick view modal -->
  <div class="modal" id="quickModal" role="dialog" aria-modal="true" aria-label="Product quick view">
    <div class="modal-box">
      <button class="modal-close" data-close aria-label="Close">✕</button>
      <div class="qv-grid">
        <img id="qvImg" src="{{ 'cookie-oreo-cheesecake.jpg' | asset_url }}" alt="" />
        <div class="qv-body">
          <span class="qv-badge" id="qvBadge" style="display:none"></span>
          <h3 id="qvName"></h3>
          <div class="stars" id="qvStars"></div>
          <p class="desc" id="qvDesc"></p>
          <p class="opt-label">Pack Size</p>
          <div class="pack-row" id="qvPacks"></div>
          <p class="opt-label">Quantity</p>
          <div class="qty-row">
            <button class="qty-btn" id="qvMinus" aria-label="Decrease quantity">−</button>
            <span class="qty-num" id="qvQty">1</span>
            <button class="qty-btn" id="qvPlus" aria-label="Increase quantity">+</button>
          </div>
          <div class="qv-price" id="qvPrice"></div>
          <div class="qv-actions">
            <button class="add-btn" id="qvAdd">Add to Box</button>
            <button class="wish-btn" id="qvWish" style="position:static;width:3.1rem;height:3.1rem;box-shadow:none" aria-label="Toggle wishlist">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" style="width:1.3rem;height:1.3rem"><path d="M12 20.7C6.4 17 3 13.6 3 9.9 3 7.2 5 5 7.6 5c1.7 0 3.4.9 4.4 2.4C13 5.9 14.7 5 16.4 5 19 5 21 7.2 21 9.9c0 3.7-3.4 7.1-9 10.8Z" /></svg>
            </button>
          </div>
          <ul class="note-list">
            <li>Baked fresh on the morning your order ships</li>
            <li>Free nationwide shipping over Rs. 3,000</li>
            <li>Warm 15 seconds for the full gooey effect</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast" role="status"></div>
</body>
</html>
